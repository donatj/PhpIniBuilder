{
	"name": "donatj/php-ini-builder",
	"description": "PHP `parse_ini_string` Compatible INI Builder",
	"keywords": [
		"ini",
		"ini-builder",
		"ini-encoder",
		"ini-writer",
		"configuration"
	],
	"require": {
		"php": ">=8.2",
		"ext-ctype" : "*"
	},
	"require-dev": {
		"donatj/drop": "*",
		"donatj/mddoc": "^0.13",
		"phpunit/phpunit": "^11.0",
		"phpstan/phpstan": "^2.2",
		"corpus/coding-standard": "^0.10.0",
		"squizlabs/php_codesniffer": "^4.0",
		"friendsofphp/php-cs-fixer": "^3.1"
	},
	"license": "MIT",
	"authors": [
		{
			"name": "Jesse Donat",
			"email": "donatj@gmail.com",
			"homepage": "https://donatstudios.com",
			"role": "Developer"
		}
	],
	"autoload": {
		"psr-4": {
			"donatj\\Ini\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"donatj\\Ini\\Test\\": "test/donatj/Ini/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
